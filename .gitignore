# ─────────────────────────────────────────────────────────────
# Unity generated / cache (절대 커밋 금지 — 수백 MB, 자동 생성)
# ─────────────────────────────────────────────────────────────
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 이 프로젝트의 UWP 빌드 산출물 (Unity export + MSBuild + appx)
/Build/
/Build_*/

# Asset meta files: 폴더가 무시되면 그 meta 도 무시
/[Aa]ssets/**/*.meta.bak

# ─────────────────────────────────────────────────────────────
# IDE / 도구
# ─────────────────────────────────────────────────────────────
/.vs/
/.vscode/
/.idea/
/.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta for DLL/plugins 는 유지해야 하므로 위에서 개별 무시하지 않음

# ─────────────────────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────
# Python (PC 서버가 이 트리에 들어올 경우 대비)
# ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
/out/

# ─────────────────────────────────────────────────────────────
# 서명 인증서 (개인키 포함 — 각자 생성 권장). 필요하면 이 줄 지우고 커밋.
# ─────────────────────────────────────────────────────────────
*.pfx

# 크래시/프로파일 덤프
*.pftrace
sysdiag*.zip

# 도구 stray 파일
.autocomplete.jsonl
/Build/export*.log
/Build/msbuild*.log

# Local agent settings (may contain credentials)
.claude/settings.local.json

# 내부 감사 보고서 — 로컬 참조용. 로컬 절대경로·사용자명을 증거로 인용하고 있고
# 저장소의 취약점 이력을 담고 있어 공개하지 않는다.
/docs/PUBLIC_RELEASE_AUDIT.md

# ─────────────────────────────────────────────────────────────
# 네이티브 플러그인 빌드 산출물 (native/srt3d_uwp/)
# ⚠️ 반드시 /native/ 로 한정할 것. 전역 규칙으로 두면:
#    *.obj  → Assets/StreamingAssets/srt3d/*.obj (Wavefront 추적 mesh, 추적 중) 를 삼킨다
#    ARM64/ → Assets/Plugins/WSA/ARM64/*.dll (추적 중) 를 삼킨다
# ─────────────────────────────────────────────────────────────
/native/**/build*/
/native/**/CMakeFiles/
/native/**/CMakeCache.txt
/native/**/.vs/
/native/**/x64/
/native/**/ARM64/
/native/**/*.obj
/native/**/*.pdb
/native/**/*.ilk
/native/**/*.exp
/native/**/*.lib
/native/**/*.dll

# Eigen 3.4.0 은 setup 으로 받는다 (9.5MB, 커밋하지 않음) — native/srt3d_uwp/README.md 참조
/native/srt3d_uwp/third_party/eigen3/

# ─────────────────────────────────────────────────────────────
# Microsoft 재배포 금지 DLL — 독점 EULA 라 저장소에 포함할 수 없다.
# NuGet 에서 직접 받을 것. 복원 절차는 README.md 「Microsoft SDK DLL 복원」 참고.
#   (현재 프로젝트 구성에서는 없어도 빌드된다 — 원상태 재현용)
# ─────────────────────────────────────────────────────────────
/Assets/Plugins/WSA/ARM64/Microsoft.MixedReality.EyeTracking.dll
/Assets/Plugins/WSA/ARM64/Microsoft.MixedReality.EyeTracking.dll.meta
/Assets/Plugins/WSA/ARM64/Microsoft.MixedReality.SceneUnderstanding.dll
/Assets/Plugins/WSA/ARM64/Microsoft.MixedReality.SceneUnderstanding.dll.meta
